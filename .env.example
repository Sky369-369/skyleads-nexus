# ============================================
# SKYLEAD - ENVIRONMENT CONFIGURATION
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/skylead

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d
BCRYPT_ROUNDS=10

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# PAYMENT PROCESSING
# ============================================

# Stripe (for bank transfers/cards)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Crypto Wallets (for crypto payouts)
# Bitcoin
BTC_WALLET_ADDRESS=your_btc_wallet_address
BTC_PRIVATE_KEY=your_btc_private_key

# Ethereum
ETH_WALLET_ADDRESS=your_eth_wallet_address
ETH_PRIVATE_KEY=your_eth_private_key
INFURA_PROJECT_ID=your_infura_project_id

# Solana
SOL_WALLET_ADDRESS=your_sol_wallet_address
SOL_PRIVATE_KEY=your_sol_private_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# USDT (Tether)
USDT_CONTRACT_ADDRESS=0xdac17f958d2ee523a2206206994597c13d831ec7
USDT_WALLET_ADDRESS=your_usdt_wallet_address

# ============================================
# EMAIL CONFIGURATION
# ============================================

# SMTP Settings (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@skylead.io

# ============================================
# LEAD PROVIDERS
# ============================================

# Lead distribution endpoints
LEAD_PROVIDER_1_API=https://api.leadprovider1.com
LEAD_PROVIDER_1_KEY=your_api_key_1

LEAD_PROVIDER_2_API=https://api.leadprovider2.com
LEAD_PROVIDER_2_KEY=your_api_key_2

# ============================================
# ANALYTICS & MONITORING
# ============================================

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn

# ============================================
# RATE LIMITING
# ============================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# PAYOUT SETTINGS
# ============================================

# Minimum payout thresholds
MIN_PAYOUT_USD=10
MIN_PAYOUT_CRYPTO=15

# Payout processing fees
BANK_TRANSFER_FEE_PERCENT=2
CRYPTO_TRANSFER_FEE_PERCENT=1

# Auto-payout threshold
AUTO_PAYOUT_THRESHOLD=100

# ============================================
# LEAD PRICING
# ============================================

# Payout rates per category (in USD)
PAYOUT_FINANCE=85
PAYOUT_INSURANCE=65
PAYOUT_SOLAR=55
PAYOUT_HOME_SERVICES=35
PAYOUT_OTHER=25

# ============================================
# SYSTEM SETTINGS
# ============================================

# Timezone
TZ=UTC

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# File upload limits
MAX_FILE_SIZE=5242880

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Debug mode
DEBUG=true
LOG_LEVEL=debug
